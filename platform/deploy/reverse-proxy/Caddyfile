# YOU HEAL Clinical — Caddy v2 reverse proxy (>= 2.8 for tls_trust_pool; see note for older).
# Install as /etc/caddy/Caddyfile (or `import` it). Validate: caddy validate --config /etc/caddy/Caddyfile
#
# Backend: sudo ./install.sh --host 127.0.0.1 --trust-proxy --public-origin https://clinic.example.org
#   -> YH_HOST=127.0.0.1, YH_TRUST_PROXY=1, YH_PUBLIC_ORIGIN=https://clinic.example.org
# Caddy sets X-Forwarded-For (appending the client address), X-Forwarded-Proto and X-Forwarded-Host
# by default; with YH_TRUST_PROXY=1 the server trusts exactly this one hop. Never enable
# YH_TRUST_PROXY when clients can reach the backend directly.
#
# Copy the backend's PUBLIC certificate so Caddy can verify it (the data dir is 0700):
#   sudo install -m 0644 /var/lib/youheal/tls/cert.pem /etc/caddy/youheal-backend.crt

{
	# Global options
	servers {
		protocols h1 h2
	}
	# Air-gapped clinic without public DNS? Use an internal CA instead of ACME:
	#   local_certs
}

clinic.example.org {
	# Certificate: (a) automatic ACME (public DNS name, port 80/443 reachable) — omit the line below;
	# (b) a CA-issued file pair:
	tls /etc/ssl/youheal/fullchain.pem /etc/ssl/youheal/privkey.pem {
		protocols tls1.2 tls1.3
	}
	# (c) Caddy's internal CA (distribute its root to clinic workstations): tls internal

	request_body {
		max_size 5MB
	}

	header {
		# Single, proxy-controlled HSTS value (the app's own is replaced). Add "; preload" deliberately.
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		-Server
		-Via
	}

	# Defense in depth: first-run setup is never reachable through the proxy.
	@setup path /api/v1/setup
	respond @setup 403

	# NOTE: no `encode` directive — compressing API responses that carry CSRF tokens next to reflected
	# input enables BREACH-style attacks.

	reverse_proxy https://127.0.0.1:8443 {
		transport http {
			tls_server_name localhost
			tls_trust_pool file /etc/caddy/youheal-backend.crt
			# Caddy < 2.8: replace the line above with
			#   tls_trusted_ca_certs /etc/caddy/youheal-backend.crt
			dial_timeout 5s
			response_header_timeout 60s
		}
		header_down -Server
	}

	log {
		output file /var/log/caddy/youheal.access.log {
			roll_size 50MiB
			roll_keep 10
		}
		format json
	}
}

# HTTP -> HTTPS redirect is automatic for site blocks with a hostname.
